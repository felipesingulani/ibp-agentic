{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ibp-agentic.local/schemas/a4-reason.schema.json",
  "title": "A4Reason",
  "description": "V0 — razão always-on do otimizador A4. severity canônico: info|warn|block (UX pode mapear baixa|media|alta).",
  "type": "object",
  "additionalProperties": false,
  "required": ["rank", "kind", "summary", "refs", "severity"],
  "properties": {
    "rank": { "type": "integer", "minimum": 1 },
    "kind": {
      "type": "string",
      "enum": ["janela", "capacidade", "contrato", "custo", "outro"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeId": { "type": ["string", "null"] },
        "skuId": { "type": ["string", "null"] },
        "routeId": { "type": ["string", "null"] },
        "period": { "type": ["string", "null"] }
      }
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warn", "block"],
      "description": "Mapa UX: baixa→info, media→warn, alta→block"
    }
  }
}
