# Copie para .env (nunca commitar .env). Valores abaixo são SÓ para dev local (docker-compose.yml).
# Owner/admin — usado só por migrate/seed/testes:
MIGRATION_DATABASE_URL=postgres://ibp:ibp_dev_only@localhost:5432/ibp_v0
# Role do app (sem superuser, sem BYPASSRLS) — criada pelo `npm run migrate`:
APP_DB_USER=ibp_app
APP_DB_PASSWORD=change_me_dev_only
DATABASE_URL=postgres://ibp_app:change_me_dev_only@localhost:5432/ibp_v0
PORT=3000
# CORS: origem permitida (vazio = sem CORS cross-origin)
CORS_ORIGIN=
# W2 ditado (LLM só aqui; vazio = 502 ditado_unavailable). Provedor HTTP genérico, formato "messages"; modelo barato.
DITADO_LLM_URL=
DITADO_LLM_KEY=
DITADO_LLM_MODEL=
DITADO_TIMEOUT_MS=8000
DITADO_DAILY_CALL_CAP=300
# T-A4-SOLVER-WORKER: worker A4 remoto (vazio = spawn local solver/.venv). Prod Vercel: Deivid seta no publish.
A4_SOLVER_URL=
A4_SOLVER_SECRET=
